---
import { HEADQUARTERS } from '@/data/about';
---

<section class="hq container" aria-labelledby="hq-title">
  <h2 id="hq-title" class="hq__title">
    Our headquarters
  </h2>

  <ul class="hq__list" role="list">
    {HEADQUARTERS.map(({ country, addressLines, phone, icon: Icon }, index) => (
      <li class="hq__item" data-reveal="fade-up" data-reveal-delay={index * 150}>
        <Icon class="hq__icon" aria-hidden="true" />
        <h3 class="hq__country">{country}</h3>
        <address class="hq__address">
          {addressLines.map((line) => (
            <span>{line}</span>
          ))}
          <a href={`tel:${phone.replaceAll(' ', '')}`}>{phone}</a>
        </address>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  .hq {
    margin-bottom: var(--section-gap);

    @include mq(lg) {
      padding-inline: 5.3125rem;
    }
  }

  .hq__title {
    @include heading('h4');

    margin-bottom: 4.5rem;
    color: var(--color-muted);
    text-align: center;

    @include mq(md) {
      text-align: left;
    }
  }

  .hq__list {
    display: grid;
    gap: 5rem;
    text-align: center;

    @include mq(md) {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.625rem;
      text-align: left;
    }

    @include mq(lg) {
      gap: 5.9375rem;
    }
  }

  .hq__icon {
    height: 3rem;
    width: auto;
    margin: 0 auto 3rem;

    @include mq(md) {
      margin-inline: 0;
    }
  }

  .hq__country {
    @include heading('h3');

    margin-bottom: 1.5rem;
  }

  .hq__address {
    display: grid;
    font-size: var(--fs-lead);
    font-style: normal;
    opacity: 0.8;

    a:hover {
      color: var(--color-primary);
    }
  }
</style>
