---
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/Button.astro';
import { BREAKPOINTS } from '@/lib/breakpoints';
import { getResponsiveSource } from '@/lib/images';

interface Props {
  title: string;
  text: string;
  images: {
    desktop: ImageMetadata;
    tablet?: ImageMetadata;
    mobile: ImageMetadata;
  };
  cta?: { label: string; href: string };
  size?: 'lg' | 'md';
}

const { title, text, images, cta, size = 'md' } = Astro.props;

const [desktop, tablet, mobile] = await Promise.all([
  getResponsiveSource(images.desktop),
  images.tablet ? getResponsiveSource(images.tablet) : undefined,
  getResponsiveSource(images.mobile),
]);
const sizes = `(min-width: ${BREAKPOINTS.xl}px) ${BREAKPOINTS.xl}px, 100vw`;
---

<section class:list={['hero', `hero--${size}`, 'container']}>
  <picture>
    <source media={`(max-width: ${BREAKPOINTS.sm - 0.02}px)`} srcset={mobile.srcset} {sizes} />
    {tablet && (
      <source media={`(max-width: ${BREAKPOINTS.md - 0.02}px)`} srcset={tablet.srcset} {sizes} />
    )}
    <img
      class="hero__image"
      src={desktop.src}
      srcset={desktop.srcset}
      {sizes}
      alt=""
      width={images.desktop.width}
      height={images.desktop.height}
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="hero__content" data-reveal="fade-up">
    <h1 class="hero__title">{title}</h1>
    <p class="hero__text">{text}</p>
    {cta && <Button href={cta.href}>{cta.label}</Button>}
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    display: grid;
    overflow: hidden;
    color: var(--color-cream);
    background-color: var(--color-ink-deep);
    border-radius: var(--radius-lg);

    > * {
      grid-area: 1 / 1;
    }
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero--md {
    min-height: 25rem;

    @include mq(md) {
      min-height: 28.125rem;
    }
  }

  .hero--lg {
    min-height: 31.25rem;

    @include mq(lg) {
      min-height: 37.5rem;
    }
  }

  .hero__content {
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    align-self: center;
    max-width: 28rem;
    padding: 6rem 1.5rem;
    text-align: center;
    justify-self: center;

    @include mq(sm) {
      align-items: flex-start;
      padding: 0 0 0 clamp(3.625rem, 6vw, 5.3125rem);
      text-align: left;
      justify-self: start;
    }
  }

  .hero__title {
    @include heading('h2');

    .hero--lg & {
      font-size: var(--fs-h1);
      line-height: var(--lh-h1);
    }
  }

  .hero__text {
    font-size: var(--fs-lead);
    opacity: 0.8;

    .hero--lg & {
      margin-bottom: 1rem;
    }
  }
</style>
